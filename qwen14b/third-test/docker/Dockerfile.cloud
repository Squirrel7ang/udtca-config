# third-test 云侧（powerone1 / 10.205.200.14）冻结镜像
#
# 全部依赖都烧进镜像：代码、Megatron 运行时、训练语料、psgd/bitscom 的
# editable 安装（bitscom 的 C++/CUDA 扩展在构建时按本机编译）。
# 运行期除了 /data、/home、/dev 这些宿主资源，不再依赖镜像外的任何代码/语料/脚本。
#
#   docker build -t udtca-third-test:cloud-20261105 \
#       -f /data1/tangruijing/third-test/build/Dockerfile.cloud \
#       /data1/tangruijing/third-test/build
FROM corex:4.5.0.20261008-ubuntu22.04-llm-py3.12-v2

LABEL udtca.third-test.role="cloud"
LABEL udtca.third-test.host="powerone1"
LABEL udtca.third-test.frozen="20261105"

ENV COREX_PATH=/usr/local/corex \
    CUDA_HOME=/usr/local/corex \
    NCCL_LIB_DIR=/usr/local/corex/lib64 \
    LD_LIBRARY_PATH=/usr/local/corex/lib64:/usr/local/lib

# 云侧：把宿主机现役的 Corex 运行时库烧进镜像（边侧同理，来源是 docker_libs）。
# 基础镜像自带的 /usr/local/corex/lib64/libcuda.so.1 只是个 stub，构建期 import torch
# 会报 "file too short"，也没法编译 bitscom。
COPY ctx/host_libs/libcuda.so.1 /usr/local/corex/lib64/libcuda.so.1
COPY ctx/host_libs/libcuda.so.1 /usr/local/corex/lib64/libcuda.so
COPY ctx/host_libs/libixml.so   /usr/local/corex/lib64/libixml.so
COPY ctx/host_libs/ixsmi        /usr/local/corex/bin/ixsmi

COPY ctx/udtca            /workspace/udtca
COPY ctx/megatron-runtime /workspace/megatron-runtime
COPY ctx/megatron-data    /workspace/megatron-data

COPY udtca_manifest.txt    /workspace/udtca_manifest.txt
COPY megatron_manifest.txt /workspace/megatron_manifest.txt
COPY megatron_data_manifest.txt /workspace/megatron_data_manifest.txt

# 基础镜像里缺的运行时依赖（版本与 trj-udtca 现役容器一致；
# pyarrow 必须 <=18：19+ 要 numpy>=2，而基础镜像是 numpy 1.26.4）
RUN pip install --no-cache-dir tensorboard==2.21.0 datasets==3.2.0 pyarrow==18.1.0 \
 && python -c "import tensorboard, datasets, pyarrow; \
print('tensorboard:', tensorboard.__version__, 'datasets:', datasets.__version__, 'pyarrow:', pyarrow.__version__)"

# editable 安装：往 site-packages 写 __editable__.psgd / __editable__.bitscom 的 .pth，
# 指向 /workspace/udtca/{polar-sgd/src,bitscom/python}。bitscom 在这里按本机编译。
# --no-deps：torch/transformers/sentencepiece 基础镜像已有，datasets 上面刚装；
# psgd 声明里的多数依赖并不在 import 路径上，避免去索引里解析版本。
RUN pip install --no-build-isolation --no-index --no-deps -e /workspace/udtca/polar-sgd \
 && pip install --no-build-isolation --no-index --no-deps -e /workspace/udtca/bitscom \
 && python -c "import psgd, bitscom; \
print('psgd:', psgd.__file__); print('bitscom:', bitscom.__file__)"

# polar 的 fineweb token 缓存（480 blocks × seq256）：镜像离线运行，
# polar 起手会按 samplesN=max_steps×micro_batches 找缓存，找不到就去连
# HF —— 离线模式下必然失败。缓存文件名带节点标签，所以两台镜像各烤一份。
COPY ctx/polar-cache /workspace/udtca/experiments/qwen14b/cache

# Megatron 的 GPTDataset 索引缓存：原本运行时由 16 个本地 rank 并发构建，
# 写 description 与写 .npy 之间有窗口，rank 会读到还没生成的 .npy 而
# FileNotFoundError。烤进镜像后所有 rank 直接走 load 分支，竞态不存在。
COPY ctx/megatron-cache /workspace/megatron-data/fineweb_sample-10BT/cache

# Qwen2.5 tokenizer 的 HF 缓存（Megatron 的 HuggingFaceTokenizer 要用）：
# 烤进镜像 + 关掉联网解析，运行期不依赖宿主机的 ~/.cache/huggingface 或 hf-mirror。
COPY ctx/hf-cache /workspace/hf-cache
ENV HF_HOME=/workspace/hf-cache \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

RUN chmod 755 /usr/local/corex/bin/ixsmi && mkdir -p /workspace/udtca/run_log && ln -sfn /data /data1

WORKDIR /workspace/udtca
