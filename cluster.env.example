# udtca 两机训练 / 实时指标 API 的集群配置。
#
# 用法：复制一份再改，并在启动 python 之前 source：
#
#   cp udtca-config/cluster.env.example udtca-config/cluster.env
#   vi udtca-config/cluster.env
#   source udtca-config/cluster.env
#
# 这些变量在 common/case_common.py 被 import 时读取一次，所以必须在启动
# run.py / start_metrics_api.py 之前 source；运行途中再改不生效。
# 不 source 时全部用下面的默认值（即当前 u13 / u177 这套）。
#
# 注意：整套编排只在 node 0 上执行，node 1 的脚本由它通过 ssh/scp 下发。

# ---- node 0：执行编排、跑 node_rank=0 的机器（就是你现在这台）--------------
# HOST 只是显示用标签（终端输出、case.json、注释），不参与连接；
# IP 会写进 MASTER_ADDR，node_rank=0 要 bind 它，必须是本机真实地址。
export UDTCA_NODE0_HOST=13
export UDTCA_NODE0_IP=10.31.10.13

# ---- node 1：node_rank=1，通过 ssh/scp 访问 --------------------------------
# 可以填 IP，也可以填 ~/.ssh/config 里的别名（要求免密）。
export UDTCA_NODE1_HOST=10.31.10.177
# tc 限速的 iptables peer 规则、case.json 用；加 --no-tc 时可以不关心。
export UDTCA_NODE1_IP=10.31.10.177

# ---- 两机共用的目录与网卡 --------------------------------------------------
# node 1 上的仓库绝对路径，必须和 node 0 一致（脚本、日志、run_log 都按它拼）。
export UDTCA_REMOTE_BASE_DIR=/data1/tangruijing/udtca

# 两机互联的网卡：写进 NCCL_SOCKET_IFNAME，也是 tc 限速 / 字节统计用的网卡。
export UDTCA_NIC_IFACE=ens1f0

# 两机同名的 conda 环境（torchrun、bitscom、polar-sgd 都在里面）。
export UDTCA_CONDA_ENV=udtca
